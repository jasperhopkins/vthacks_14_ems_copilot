# Dependencies -- restored by `npm install` from the committed lockfile.
mobile/node_modules/

# A vendored copy of the AWS CLI and its installer. This is a tool you
# install, not a dependency of the project; it was ~113 MB of the repo.
/aws/
/awscliv2.zip

# SAM build output -- regenerated by `sam build`, and every deploy
# rewrites it, so tracking it makes each deploy look like a code change.
.aws-sam/

# Python bytecode
__pycache__/
*.py[cod]

# Expo local state: device registrations and dev-server logs, which are
# per-machine and change on every `expo start`/`expo export`.
.expo/
dist/
web-build/
*.tsbuildinfo

# Credentials and local environment. Nothing here is currently committed
# and nothing should be -- see docs/HIPAA_NOTES.md. Stack identifiers that
# the app legitimately ships (mobile/src/config.js) are NOT secrets and
# stay tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
.aws/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
